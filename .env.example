PORT=5000
NODE_ENV=development

# ─────────────────────────────────────────────────────────────────────────────
# DATABASE — set this or your data will not survive a restart / redeploy
# ─────────────────────────────────────────────────────────────────────────────
# Leave EMPTY only for a throwaway demo run: the server then uses a temporary
# in-memory MongoDB that is wiped (and re-seeded with demo data) every time the
# process restarts.
#
# To keep content added from the admin panel, point this at a real MongoDB:
#   Render dashboard -> your service -> Environment -> MONGODB_URI
#   Example: mongodb+srv://<user>:<password>@cluster0.xxxxx.mongodb.net/american_futuretech?retryWrites=true&w=majority
MONGODB_URI=

# Set to false to disable the demo auto-seed entirely (recommended once the
# database holds real content and may be replaced/re-created).
SEED_ON_BOOT=true

# ─────────────────────────────────────────────────────────────────────────────
# AUTH — must be a unique random string in production (never the default!)
# ─────────────────────────────────────────────────────────────────────────────
# Generate one with: node -e "console.log(require('crypto').randomBytes(48).toString('hex'))"
JWT_SECRET=
JWT_EXPIRE=7d
CLIENT_URL=http://localhost:5173

# ─────────────────────────────────────────────────────────────────────────────
# PAYMENTS — Stripe Checkout (real card payments)
# ─────────────────────────────────────────────────────────────────────────────
# Without these keys checkout safely falls back to a manual admissions enquiry
# and NO payment is ever recorded as paid.
#
# 1. STRIPE_SECRET_KEY            dashboard.stripe.com -> Developers -> API keys
# 2. STRIPE_WEBHOOK_SECRET        Developers -> Webhooks -> add endpoint
#                                 URL: https://<your-api-domain>/api/payments/webhook
#                                 Events: checkout.session.completed,
#                                         checkout.session.async_payment_succeeded,
#                                         checkout.session.async_payment_failed,
#                                         checkout.session.expired,
#                                         payment_intent.payment_failed
# NOTE: enrollments are ONLY confirmed from a signature-verified webhook, so if
# the webhook secret is missing, paid students never get activated.
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=
PAYMENT_CURRENCY=USD

# Email Notifications (Optional - console logging fallback enabled)
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USER=
SMTP_PASS=
NOTIFICATION_EMAIL=info@americantechgloballlc.com
