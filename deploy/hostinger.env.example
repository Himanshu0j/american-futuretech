# ─────────────────────────────────────────────────────────────────────────────
# American FutureTech — Hostinger (Node.js Web App) environment variables.
#
# Kaise use karein:
#   1. Is file ki copy banao:  hostinger.env  (isme apni values bharo)
#   2. hPanel → website → Environment variables → "Import .env" → wahi file upload
#   3. Save → Hostinger khud redeploy kar dega (values build + runtime dono me
#      inject hoti hain, isliye VITE_API_URL jaise build-time var bhi yahin set
#      karna hai)
#
# ⚠️  Bhari file (values ke saath) kabhi git me commit na karein.
# Poora step-by-step: docs/DEPLOY-HOSTINGER.md
# ─────────────────────────────────────────────────────────────────────────────

# ── Mode ─────────────────────────────────────────────────────────────────────
# MUST be production. Sirf isi value par server/server.js built website
# (client/dist) ko serve karta hai; warna root URL JSON dega.
NODE_ENV=production

# PORT yahan set na karein — Hostinger app process ko PORT khud inject karta
# hai, aur code ka default 5000 hai (server/server.js: process.env.PORT || 5000).

# ── Database (MongoDB Atlas — wahi cluster jo abhi live hai) ──────────────────
# Courses, admin content, settings, uploads aur Stripe keys sab isi DB me hain,
# isliye yahi URI reuse karein. Password me special character ho to URL-encode
# karein (@ -> %40, # -> %23).
MONGODB_URI=mongodb+srv://<user>:<password>@<cluster>.mongodb.net/american_futuretech?retryWrites=true&w=majority

# DB na mile to boot fail ho (chupke se temporary DB par na chale).
REQUIRE_PERSISTENT_DB=true

# DB me pehle se real content hai — demo dataset dobara kabhi na bane.
SEED_ON_BOOT=false

# ── Auth ─────────────────────────────────────────────────────────────────────
# ⚠️  YE RENDER SE COPY KARO, NAYA GENERATE MAT KARO.
#  - har admin/student session token isi se sign hota hai, aur
#  - Admin → Payment Gateway me save kiye gaye Stripe keys ISSE derive hui key
#    se encrypt hain. Value badal gayi to LIVE payments band ho jayenge jab tak
#    keys dobara paste na karo.
#    (Render → american-futuretech-api → Environment → JWT_SECRET → copy)
JWT_SECRET=<render se copy karein>
JWT_EXPIRE=7d

# ── Public origin ────────────────────────────────────────────────────────────
# Jis domain par site chalti hai. Isse CORS, Stripe ke success/cancel redirect
# aur admin panel ka bataya gaya webhook URL banta hai. Exactly origin likhein
# (https:// ke saath, aakhir me / nahi).
CLIENT_URL=https://<domain>

# ── Build-time (frontend) ────────────────────────────────────────────────────
# Vite build me API ka public origin. Same-origin deployment me bhi ise set karna
# fayda deta hai: admin panel me "copy brief" karne par uploaded image ka URL
# Render ka nahi, is naye domain ka banta hai.
VITE_API_URL=https://<domain>/api

# ── Payments ─────────────────────────────────────────────────────────────────
# Kuch add karne ki zaroorat nahi: LIVE Stripe keys already database me save hain
# (Admin → Payment Gateway, source = admin-panel) aur JWT_SECRET same hone se
# waise hi kaam karti rahengi. Env-level keys chahiye to sirf tab:
# STRIPE_SECRET_KEY=
# STRIPE_WEBHOOK_SECRET=
PAYMENT_CURRENCY=USD

# Optional: agar proxy Host header badal de to Stripe ko dikhne wala API origin
# ise force karein.
# PUBLIC_API_URL=https://<domain>

# ── Email (optional — na bharo to email console log me jayega) ───────────────
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USER=
SMTP_PASS=
NOTIFICATION_EMAIL=info@americanfuturetechllc.com
