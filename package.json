{
  "name": "american-futuretech",
  "version": "1.0.0",
  "description": "Production-grade futuristic EdTech platform & enterprise Admin Panel",
  "private": true,
  "scripts": {
    "start": "node server/server.js",
    "build": "npm --prefix client run build",
    "server": "cd server && npm run dev",
    "client": "cd client && npm run dev",
    "dev": "concurrently -n \"SERVER,CLIENT\" -c \"blue,cyan\" \"npm run server\" \"npm run client\"",
    "seed": "node server/seed.js",
    "verify:payments": "node scripts/verify-payments.js",
    "verify:cms": "node scripts/verify-cms-settings.js",
    "verify:auth": "node scripts/verify-auth.js",
    "verify:editor": "node scripts/verify-site-editor.js",
    "verify:admin-fields": "node scripts/audit-admin-fields.js --strict",
    "verify:admin": "node scripts/verify-admin-crud.js",
    "rotate:admin": "node scripts/rotate-admin-credentials.js",
    "install:all": "npm install && cd server && npm install && cd ../client && npm install",
    "verify:jobs": "node scripts/verify-jobs-board.js",
    "verify:coupons": "node scripts/verify-coupons.js",
    "verify:students": "node scripts/verify-student-access.js",
    "verify:analytics": "node scripts/verify-analytics-honesty.js",
    "verify:credentials": "node scripts/verify-credential-guard.js",
    "verify:lms": "node scripts/verify-lms-admin.js",
    "verify:security": "node scripts/verify-security-hardening.js",
    "verify:rbac": "node scripts/verify-rbac-matrix.js",
    "verify:db": "node scripts/verify-db.js",
    "verify:live": "node scripts/verify-live-qa.js",
    "audit:a11y": "node scripts/audit-accessibility.js",
    "audit:browser": "node scripts/audit-live-browser.js",
    "audit:testdata": "node scripts/audit-test-data.js"
  },
  "devDependencies": {
    "concurrently": "^9.1.0",
    "puppeteer-core": "^25.11.0"
  },
  "dependencies": {
    "localtunnel": "^2.0.2"
  }
}
